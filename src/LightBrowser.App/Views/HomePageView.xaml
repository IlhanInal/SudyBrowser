<UserControl x:Class="SudyBrowser.App.Views.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <!-- The search pill grows from both sides (it is centered) while it has keyboard focus. -->
        <Style x:Key="ExpandingSearchPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Width" Value="250" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="520" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="250" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Image Source="{Binding Settings.SelectedBackground.ImageUri}" Stretch="UniformToFill" />
        <!-- #545454 translucent layer that tones the photo down, as in the design. -->
        <Rectangle Fill="{DynamicResource ScrimBrush}" IsHitTestVisible="False" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,90">
            <!-- SUDY Browser Logo (Temaya göre otomatik değişen HomeLogoSource) -->
            <Image Source="{DynamicResource HomeLogoSource}"
                   Width="440" Height="73"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   ToolTip="SUDY Browser"
                   AutomationProperties.Name="SUDY Browser" />

            <Border Style="{StaticResource ExpandingSearchPill}" Height="44" CornerRadius="22"
                    HorizontalAlignment="Center" Margin="0,40,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Margin="18,0,4,0" FontSize="12.5"
                             Style="{StaticResource PlainTextBox}"
                             Text="{Binding HomeSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Arama yapın">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding HomeSearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Arama Yapın" Margin="19,0,4,0" FontSize="12.5" IsHitTestVisible="False"
                               VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Content="&#xE721;" Style="{StaticResource IconButton}" Margin="0,0,10,0"
                            Foreground="{DynamicResource SubtleTextBrush}"
                            Command="{Binding HomeSearchCommand}"
                            ToolTip="Ara" AutomationProperties.Name="Ara" />
                </Grid>
            </Border>

            <!-- Bookmarks shortcut tiles on home page: appears only when bookmarks exist (max 6) -->
            <ItemsControl ItemsSource="{Binding Shortcuts}" HorizontalAlignment="Center" Margin="0,32,0,0"
                          IsTabStop="False"
                          Visibility="{Binding HasShortcuts, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" MaxWidth="920" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Tile" Style="{StaticResource TileButton}" Margin="10,8"
                                Command="{Binding DataContext.OpenShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                            <StackPanel Visibility="{Binding HasSite, Converter={StaticResource BoolToVisibility}}">
                                <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TileTextBrush}" />
                                    <Image Source="{Binding FaviconUrl}" Width="32" Height="32"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <TextBlock Text="{Binding Title}" Margin="8,5,8,0" FontSize="11.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                           Foreground="{DynamicResource TileTextBrush}" />
                            </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasSite}" Value="False">
                                <Setter TargetName="Tile" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
