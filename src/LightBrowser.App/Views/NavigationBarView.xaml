<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:SudyBrowser.App.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="SudyBrowser.App.Views.NavigationBarView"
             >
    <UserControl.Resources>
        <!-- Suggestion rows: same palette as the rest of the bar; hover and keyboard selection share one highlight. -->
        <Style x:Key="SuggestionItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Row" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource FieldBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource BoxBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain, non-focusable click target so the address box keeps keyboard focus while the list is used. -->
        <Style x:Key="SuggestionButton" TargetType="{x:Type Button}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SuggestionTemplate" DataType="{x:Type viewModels:SuggestionItemViewModel}">
            <Button Style="{StaticResource SuggestionButton}"
                    Command="{Binding DataContext.AcceptSuggestionCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                    CommandParameter="{Binding}">
                <Grid Margin="12,6,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE774;"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource IconBrush}" />
                        <Image x:Name="FaviconImage" Source="{Binding Favicon}" Width="16" Height="16"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="UrlLine" Text="{Binding DisplayUrl}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SubtleTextBrush}" />
                    </StackPanel>

                    <TextBlock x:Name="SourceLabel" Grid.Column="2" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleTextBrush}" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="History">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE81C;" />
                    <Setter TargetName="SourceLabel" Property="Text" Value="Geçmiş" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="Bookmark">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE735;" />
                    <Setter TargetName="SourceLabel" Property="Text" Value="Yer imi" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="Site">
                    <Setter TargetName="SourceLabel" Property="Text" Value="Site" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="Search">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE721;" />
                    <Setter TargetName="SourceLabel" Property="Text" Value="Arama" />
                    <Setter TargetName="UrlLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                    <Setter TargetName="FaviconImage" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="DownloadItemTemplate" DataType="{x:Type viewModels:DownloadItemViewModel}">
            <!-- Rounded card with bottom shadow edge, dynamic theme support -->
            <Border Margin="0,0,0,14" Background="{DynamicResource PopupBrush}" CornerRadius="18"
                    BorderBrush="{DynamicResource BoxShadowBrush}" BorderThickness="0,0,0,4" Padding="18,12,18,12">
                <Grid>
                    <!-- Top row (shared by both active and finished states): File Icon + File Name + Right Action Area -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Icon + FileName on left, State-specific controls on right -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- File document icon with colored extension ribbon (e.g. EXE) -->
                            <Grid Grid.Column="0" Width="32" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                                <!-- Document sheet with folded corner -->
                                <Border Width="26" Height="32" HorizontalAlignment="Right" Background="{DynamicResource FieldBrush}"
                                        BorderBrush="{DynamicResource BoxHoverBrush}" BorderThickness="1" CornerRadius="3">
                                    <StackPanel VerticalAlignment="Bottom" Margin="4,0,4,4">
                                        <Rectangle Height="1.5" Fill="{DynamicResource SubtleTextBrush}" Margin="0,0,0,2.5" />
                                        <Rectangle Height="1.5" Fill="{DynamicResource SubtleTextBrush}" Margin="0,0,3,2.5" />
                                        <Rectangle Height="1.5" Fill="{DynamicResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <!-- Extension badge pill -->
                                <Border Background="{Binding BadgeBrush}" CornerRadius="2.5" Padding="3.5,1"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="White" FontWeight="Bold"
                                               FontSize="8" />
                                </Border>
                            </Grid>

                            <!-- Bold file name -->
                            <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                       FontWeight="Bold" FontSize="17" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ResultFilePath}" />

                            <!-- Right controls when IN PROGRESS or PAUSED: %76 + Pause/Resume + Cancel -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsActiveLayout, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding PercentText}" FontWeight="Bold" FontSize="12.5"
                                           Foreground="{DynamicResource IconBrush}" VerticalAlignment="Center" Margin="8,0,12,0" />

                                <Button Style="{StaticResource IconButton}" Width="24" Height="24" Margin="0,0,6,0"
                                        Command="{Binding TogglePauseResumeCommand}"
                                        ToolTip="Duraklat / Devam Et" AutomationProperties.Name="Duraklat veya devam et">
                                    <Grid Width="12" Height="12">
                                        <!-- Pause bars (||) -->
                                        <StackPanel x:Name="PauseIcon" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Width="3.2" Height="11" RadiusX="0.6" RadiusY="0.6" Fill="{DynamicResource IconBrush}" Margin="0,0,2.5,0" />
                                            <Rectangle Width="3.2" Height="11" RadiusX="0.6" RadiusY="0.6" Fill="{DynamicResource IconBrush}" />
                                        </StackPanel>
                                        <!-- Resume triangle (▶) when paused -->
                                        <Path x:Name="ResumeIcon" Data="M2,1 L11,6 L2,11 Z" Fill="{DynamicResource IconBrush}"
                                              Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                        Command="{Binding CancelOrRemoveCommand}"
                                        ToolTip="İptal Et" AutomationProperties.Name="İndirmeyi iptal et">
                                    <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="{DynamicResource IconBrush}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="12" Height="12" Stretch="Uniform" />
                                </Button>
                            </StackPanel>

                            <!-- Right controls when COMPLETED or FAILED: Folder + Checkmark (or Retry + Remove on failure) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsFinishedLayout, Converter={StaticResource BoolToVisibility}}">
                                <!-- Completed: Folder icon + Checkmark icon -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,8,0"
                                            Command="{Binding OpenFolderCommand}"
                                            ToolTip="Klasörde Göster" AutomationProperties.Name="Klasörde göster">
                                        <Path Data="M0,2.5 C0,1.7 0.7,1 1.5,1 L5.5,1 L7,3 L14.5,3 C15.3,3 16,3.7 16,4.5 L16,11.5 C16,12.3 15.3,13 14.5,13 L1.5,13 C0.7,13 0,12.3 0,11.5 Z M0,4.5 L16,4.5"
                                              Fill="{DynamicResource IconBrush}" Width="16" Height="13" Stretch="Uniform" />
                                    </Button>

                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                            Command="{Binding OpenFileCommand}"
                                            ToolTip="Dosyayı Aç / Çalıştır" AutomationProperties.Name="Dosyayı aç">
                                        <Path Data="M1,6.5 L5,10.5 L13.5,2" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="14" Height="12" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>

                                <!-- Failed / Cancelled: Retry (if resumable) + Remove (X) -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Margin="4,0,6,0"
                                            Command="{Binding TogglePauseResumeCommand}"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Tekrar Dene" AutomationProperties.Name="Tekrar dene">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="12"
                                                   Foreground="{DynamicResource IconBrush}" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                            Command="{Binding CancelOrRemoveCommand}"
                                            ToolTip="Listeden Kaldır" AutomationProperties.Name="Listeden kaldır">
                                        <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="11" Height="11" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1A: Active Progress Bar + Bottom stats (Size | Speed pill #9eb18b | Elapsed Time) -->
                        <StackPanel Grid.Row="1" Margin="0,20,0,0"
                                    Visibility="{Binding IsActiveLayout, Converter={StaticResource BoolToVisibility}}">
                            <!-- Custom gradient progress bar (#1a2719 -> #628464 on theme-adaptive track) -->
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="8">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                                        <Grid>
                                            <Border x:Name="PART_Track" Background="{DynamicResource FieldBrush}" CornerRadius="4" Height="8" />
                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4" Height="8">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="#1a2719" Offset="0" />
                                                        <GradientStop Color="#628464" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>

                            <Grid Margin="2,7,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Total file size -->
                                <TextBlock Grid.Column="0" Text="{Binding SizeText}" FontSize="11.5"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />

                                <!-- Speed badge (#9eb18b background with gauge icon and bold speed text) -->
                                <Border Grid.Column="1" Background="#9eb18b" CornerRadius="9.5" Padding="10,2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M1.5,9 A5.5,5.5 0 1,1 12.5,9 M7,9 L10.2,5.2"
                                              Stroke="#1B1E1D" StrokeThickness="1.3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="12" Height="10" Stretch="Uniform" Margin="0,0,5,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SpeedText}" FontWeight="Bold" FontSize="9.5"
                                                   Foreground="#1B1E1D" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Elapsed time -->
                                <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" FontSize="11.5"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- Row 1B: Finished / Interrupted status line ("İndirme Tamamlandı" or error reason) -->
                        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                                   FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource IconBrush}"
                                   Margin="2,8,0,2"
                                   Visibility="{Binding IsFinishedLayout, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter TargetName="PauseIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ResumeIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Height="29">
        <!-- Capsule behind the back / forward / reload buttons. -->
        <Border Width="124" HorizontalAlignment="Left" CornerRadius="14.5"
                Background="{DynamicResource BoxBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center">
            <Button Content="&#xE72B;" Style="{StaticResource IconButton}"
                    Command="{Binding GoBackCommand}"
                    ToolTip="Geri (Alt+Sol ok)" AutomationProperties.Name="Geri" />
            <Button Content="&#xE72A;" Style="{StaticResource IconButton}"
                    Command="{Binding GoForwardCommand}"
                    ToolTip="İleri (Alt+Sağ ok)" AutomationProperties.Name="İleri" />
            <Button Content="&#xE72C;" Style="{StaticResource IconButton}"
                    Command="{Binding ReloadCommand}"
                    ToolTip="Yenile (F5)" AutomationProperties.Name="Yenile" />
        </StackPanel>

        <!-- Address field; its thick left edge is the gray crescent from the design. -->
        <Border x:Name="UrlField" Style="{StaticResource UrlPill}" Margin="98,0,0,0" CornerRadius="14.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="AddressBox" Margin="14,0,8,0"
                         Style="{StaticResource PlainTextBox}"
                         FontWeight="Bold" FontSize="12.5"
                         Text="{Binding ActiveTab.AddressText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Adres Çubuğu" ToolTip="Adres Çubuğu (Ctrl+L)"
                         TextChanged="OnAddressTextChanged"
                         PreviewKeyDown="OnAddressPreviewKeyDown"
                         LostKeyboardFocus="OnAddressLostKeyboardFocus">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding NavigateCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Download icon button: appears once a download starts and remains visible for 25 minutes. -->
                <Button x:Name="DownloadButton" Grid.Column="1" Style="{StaticResource IconButton}"
                        Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"
                        Command="{Binding Downloads.ToggleOpenCommand}"
                        Visibility="{Binding Downloads.IsButtonVisible, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="İndirmeler" AutomationProperties.Name="İndirmeler">
                    <Rectangle Width="16" Height="16" Fill="{DynamicResource IconBrush}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="pack://application:,,,/Resources/Icons/downloadicon.png" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>

                <!-- Bookmark ribbon button: adds/removes the active page in Yer İmleri. -->
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26"
                        Margin="0,0,10,0" VerticalAlignment="Center"
                        Command="{Binding ToggleBookmarkCommand}"
                        ToolTip="Yer imlerine ekle / çıkar" AutomationProperties.Name="Yer imlerine ekle veya çıkar">
                    <Path x:Name="BookmarkRibbonPath" Data="M2,0 H14 V16 H12 L8,12 L4,16 H2 V0 Z"
                          Width="12" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource IconBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- Suggestions. A popup is its own window, so it also renders above the WebView2 surface. -->
        <Popup PlacementTarget="{Binding ElementName=UrlField}" Placement="Bottom" VerticalOffset="6"
               StaysOpen="True" Focusable="False" PopupAnimation="None"
               IsOpen="{Binding Omnibox.IsOpen, Mode=OneWay}">
            <Border Width="{Binding ActualWidth, ElementName=UrlField}"
                    Background="{DynamicResource PopupBrush}"
                    BorderBrush="{DynamicResource BoxShadowBrush}" BorderThickness="1" CornerRadius="4">
                <ListBox ItemsSource="{Binding Omnibox.Suggestions}"
                         SelectedIndex="{Binding Omnibox.SelectedIndex, Mode=OneWay}"
                         ItemTemplate="{StaticResource SuggestionTemplate}"
                         ItemContainerStyle="{StaticResource SuggestionItem}"
                         Background="Transparent" BorderThickness="0" Padding="0,4"
                         Focusable="False" IsTabStop="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Öneriler" />
            </Border>
        </Popup>

        <!-- Downloads popup: matches the user's mockup with dynamic theme support -->
        <Popup PlacementTarget="{Binding ElementName=DownloadButton}" Placement="Bottom"
               HorizontalOffset="-422" VerticalOffset="10"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding Downloads.IsOpen, Mode=TwoWay}">
            <Border Width="490" Background="{DynamicResource BoxBrush}" CornerRadius="0,0,18,18"
                    BorderBrush="{DynamicResource BoxShadowBrush}" BorderThickness="0,0,0,5" Padding="20,16,20,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: "İndirmeler" bold title on left, circular close button on top-right -->
                    <Grid Grid.Row="0" Margin="4,0,0,14">
                        <TextBlock Text="İndirmeler" FontWeight="Bold" FontSize="28" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" />

                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="22" Margin="0,10,0,0"
                                Command="{Binding Downloads.ClosePopupCommand}"
                                Cursor="Hand" ToolTip="Kapat" AutomationProperties.Name="İndirmeleri kapat">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Grid>
                                        <Ellipse x:Name="Circle" Fill="{DynamicResource IconBrush}" />
                                        <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="{DynamicResource PopupBrush}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="7" Height="7" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Circle" Property="Opacity" Value="0.8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Download cards list -->
                    <ScrollViewer Grid.Row="1" MaxHeight="340" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Downloads.Items}"
                                      ItemTemplate="{StaticResource DownloadItemTemplate}"
                                      Focusable="False" IsTabStop="False" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>