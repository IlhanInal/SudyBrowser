<UserControl x:Class="LightBrowser.App.Views.TopBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LightBrowser.App.Views"
             FontFamily="{StaticResource UiFont}">
    <!-- Proportions follow the design mock-up (1024 px wide) scaled by 1.25. -->
    <Grid x:Name="Root" Background="{DynamicResource BarBrush}" Height="80"
          MouseLeftButtonDown="OnBarMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Status box: clock / RAM / CPU, switched with the arrows. -->
        <Border Grid.Column="0" Width="125" Height="71" VerticalAlignment="Top" Margin="10,0,0,0"
                Background="{DynamicResource BoxBrush}" CornerRadius="0,0,6,6"
                BorderBrush="{DynamicResource BoxShadowBrush}" BorderThickness="0,0,0,4"
                ToolTip="{Binding Status.ToolTipText}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Sol ok: Varsayılan olarak Column 0 -->
                <Button Content="&lt;" Style="{StaticResource StatusArrowButton}" Margin="4,0,0,0"
            Width="18" Height="30" Command="{Binding Status.PreviousCommand}"
            ToolTip="Önceki gösterge" AutomationProperties.Name="Önceki gösterge" />

                <!-- Orta metin: Column 1 -->
                <Viewbox Grid.Column="1" Stretch="Uniform" MaxHeight="22" Margin="3,0"
             HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status.DisplayText}"
                   FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}"
                   AutomationProperties.Name="Durum göstergesi" />
                </Viewbox>

                <!-- Sağ ok: Grid.Column="2" EKLENDİ -->
                <Button Grid.Column="2" Content="&gt;" Style="{StaticResource StatusArrowButton}" Margin="0,0,4,0"
            Width="18" Height="30" Command="{Binding Status.NextCommand}"
            ToolTip="Sonraki gösterge" AutomationProperties.Name="Sonraki gösterge" />
            </Grid>
        </Border>

        <!-- Tabs (with "+" right after them) on the first row, navigation on the second. -->
        <Grid Grid.Column="1" Margin="14,0,29,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="37.5" />
                <RowDefinition Height="6.5" />
                <RowDefinition Height="29" />
            </Grid.RowDefinitions>
            <views:TabStripView Grid.Row="0" />
            <views:NavigationBarView x:Name="NavigationBar" Grid.Row="2" Margin="-5,0,0,0" Loaded="NavigationBar_Loaded" />
        </Grid>

        <!-- Window controls, a divider line, then menu and profile. -->
        <Grid Grid.Column="2" Width="84" Margin="0,0,14,0" VerticalAlignment="Center" Height="78">
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="3" />
                <RowDefinition Height="29" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,9,0,0">
                <Button Style="{StaticResource WindowDotButton}" Background="{StaticResource DotGreenBrush}"
                        Margin="0,0,17,0" Click="OnMaximizeClick"
                        ToolTip="Büyüt / Eski boyut" AutomationProperties.Name="Büyüt veya eski boyuta getir" />
                <Button Style="{StaticResource WindowDotButton}" Background="{StaticResource DotYellowBrush}"
                        Margin="0,0,17,0" Click="OnMinimizeClick"
                        ToolTip="Simge durumuna küçült" AutomationProperties.Name="Simge durumuna küçült" />
                <Button Style="{StaticResource WindowDotButton}" Background="{StaticResource DotRedBrush}"
                        Click="OnCloseClick" ToolTip="Kapat" AutomationProperties.Name="Kapat" />
            </StackPanel>

            <Border Background="{DynamicResource BoxShadowBrush}" Margin="0,32,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0" Grid.RowSpan="3">
                <!-- Menu icon from the design: two dark bars and a gray one. -->
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Margin="0,10,10,0"
                        Command="{Binding Settings.OpenCommand}"
                        ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar">
                    <StackPanel>
                        <Rectangle Width="17" Height="1.5" Fill="{DynamicResource TextBrush}" />
                        <Rectangle Width="17" Height="1.5" Fill="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                        <Rectangle Width="17" Height="2.5" Fill="{DynamicResource BoxShadowBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}"
                        ToolTip="Profil (yakında)" AutomationProperties.Name="Profil" Margin="0,10,0,0">
                    <Grid>
                        <Ellipse Width="22" Height="22" Fill="{DynamicResource BoxBrush}"
                                 Stroke="{DynamicResource BoxShadowBrush}" StrokeThickness="1.5" />
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource IconBrush}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Loading indicator overlays the bottom edge of the bar. -->
        <ProgressBar Grid.ColumnSpan="3" VerticalAlignment="Bottom" IsIndeterminate="True" Height="2.5"
                     BorderThickness="0" Foreground="{DynamicResource AccentBrush}" Background="Transparent"
                     IsHitTestVisible="False"
                     Visibility="{Binding ActiveTab.IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <!-- Popups are separate windows, so they render above the WebView2 surface. -->
        <Popup PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
               HorizontalOffset="-236" VerticalOffset="8" StaysOpen="False"
               IsOpen="{Binding Settings.IsOpen, Mode=TwoWay}" PopupAnimation="Fade">
            <Border Width="270" Padding="14" Background="{DynamicResource PopupBrush}"
                    BorderBrush="{DynamicResource BoxShadowBrush}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Ayarlar" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextBrush}" />

                    <TextBlock Text="Tema" FontWeight="Bold" Margin="0,12,0,6" Foreground="{DynamicResource TextBrush}" />
                    <ListBox ItemsSource="{Binding Settings.Themes}" SelectedItem="{Binding Settings.SelectedTheme}"
                             Background="Transparent" BorderThickness="0" AutomationProperties.Name="Tema" >

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Ellipse Width="14" Height="14" Fill="{Binding Swatch}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Ana sayfa arka planı" FontWeight="Bold" Margin="0,12,0,6"
                               Foreground="{DynamicResource TextBrush}" />
                    <ListBox ItemsSource="{Binding Settings.Backgrounds}"
                             SelectedItem="{Binding Settings.SelectedBackground}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Arka plan">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ThumbnailUri}" Width="72" Height="40" Stretch="UniformToFill"
                                       ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
