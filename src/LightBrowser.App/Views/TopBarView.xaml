<UserControl x:Class="SudyBrowser.App.Views.TopBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SudyBrowser.App.Views"
             xmlns:viewModels="clr-namespace:SudyBrowser.App.ViewModels"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <!-- Full-pill clickable link button used for Bookmark & History rows (outer capsule is #F0F0F0 in Light theme) -->
        <Style x:Key="SavedPagePillButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OuterCapsule"
                                Background="{DynamicResource HistoryPillSideBrush}"
                                CornerRadius="19">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCapsule" Property="Background" Value="{DynamicResource SettingsCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OuterCapsule" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="OuterCapsule" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplate for Yer İmleri rows -->
        <DataTemplate x:Key="BookmarkItemTemplate" DataType="{x:Type viewModels:SavedPageItemViewModel}">
            <Grid Margin="0,0,0,10" Height="38">
                <!-- Entire row is a clickable link -->
                <Button Style="{StaticResource SavedPagePillButton}" Margin="0"
                        Command="{Binding DataContext.Settings.OpenSavedPageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left icon compartment (#F0F0F0) -->
                        <Grid Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="FallbackGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE774;"
                                       FontSize="14" Foreground="{DynamicResource IconBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="FaviconImg" Source="{Binding Favicon}" Width="20" Height="20"
                                   RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                        </Grid>

                        <!-- Right crescent compartment: page title only (no raw URL) -->
                        <Border Grid.Column="1" CornerRadius="19"
                                Background="{DynamicResource SettingsCardBrush}"
                                BorderBrush="{DynamicResource BoxShadowBrush}"
                                BorderThickness="4,0,0,0">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="Bold" FontSize="13.5"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="14,0,34,0" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Small remove (X) button overlaid on far right so clicking X removes without navigating -->
                <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Command="{Binding DataContext.Settings.RemoveBookmarkItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        ToolTip="Yer imlerinden kaldır" AutomationProperties.Name="Yer imlerinden kaldır">
                    <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="7" Height="7" Stretch="Uniform" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                    <Setter TargetName="FaviconImg" Property="Visibility" Value="Visible" />
                    <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- DataTemplate for Arama Geçmişi rows: Day header + two-tone pill (#F0F0F0 left/right, crescent title middle, time + checkbox + X) -->
        <DataTemplate x:Key="HistoryItemTemplate" DataType="{x:Type viewModels:SavedPageItemViewModel}">
            <StackPanel>
                <!-- Day section header (e.g. "Bugün - 3 Kasım 2026 Salı", "Dün - 2 Kasım 2026 Pazartesi") -->
                <TextBlock Text="{Binding DateHeader}"
                           FontWeight="Bold" FontSize="15"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="2,6,0,10"
                           Visibility="{Binding ShowDateHeader, Converter={StaticResource BoolToVisibility}}" />

                <Grid Margin="0,0,0,10" Height="38">
                    <!-- Main pill button: clicking anywhere on the icon or title opens the link -->
                    <Button Style="{StaticResource SavedPagePillButton}" Margin="0"
                            Command="{Binding DataContext.Settings.OpenSavedPageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="102" />
                            </Grid.ColumnDefinitions>

                            <!-- Left icon compartment (#F0F0F0 background from outer capsule) -->
                            <Grid Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="FallbackGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE81C;"
                                           FontSize="14" Foreground="{DynamicResource IconBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="FaviconImg" Source="{Binding Favicon}" Width="20" Height="20"
                                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                            </Grid>

                            <!-- Middle crescent compartment: lighter card background with bold page title -->
                            <Border Grid.Column="1" CornerRadius="19,0,0,19"
                                    Background="{DynamicResource SettingsCardBrush}"
                                    BorderBrush="{DynamicResource BoxShadowBrush}"
                                    BorderThickness="4,0,0,0">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="Bold" FontSize="13.5"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="14,0,10,0" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Right action compartment (#F0F0F0 background): Time (HH:mm) + Sleek CheckBox + Remove (X) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <TextBlock Text="{Binding TimeText}"
                                   FontWeight="Bold" FontSize="11.5"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <CheckBox Style="{StaticResource HistoryRowCheckBoxStyle}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Margin="0,0,6,0"
                                  ToolTip="Silmek için seç" AutomationProperties.Name="Silmek için seç" />

                        <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                Command="{Binding DataContext.Settings.RemoveHistoryItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                ToolTip="Geçmişten sil" AutomationProperties.Name="Geçmişten sil">
                            <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="7" Height="7" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                    <Setter TargetName="FaviconImg" Property="Visibility" Value="Visible" />
                    <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <!-- Proportions follow the design mock-up (1024 px wide) scaled by 1.25. -->
    <Grid x:Name="Root" Background="{DynamicResource BarBrush}" Height="80"
          MouseLeftButtonDown="OnBarMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Status box: clock / RAM / CPU, switched with the arrows. -->
        <Border Grid.Column="0" Width="125" Height="71" VerticalAlignment="Top" Margin="10,0,0,0"
                Background="{DynamicResource BoxBrush}" CornerRadius="0,0,6,6"
                BorderBrush="{DynamicResource BoxShadowBrush}" BorderThickness="0,0,0,4"
                ToolTip="{Binding Status.ToolTipText}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Sol ok: Varsayılan olarak Column 0 -->
                <Button Content="&lt;" Style="{StaticResource StatusArrowButton}" Margin="4,0,0,0"
            Width="18" Height="30" Command="{Binding Status.PreviousCommand}"
            ToolTip="Önceki gösterge" AutomationProperties.Name="Önceki gösterge" />

                <!-- Orta metin: Column 1 -->
                <Viewbox Grid.Column="1" Stretch="Uniform" MaxHeight="22" Margin="3,0"
             HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status.DisplayText}"
                   FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}"
                   AutomationProperties.Name="Durum göstergesi" />
                </Viewbox>

                <!-- Sağ ok: Grid.Column="2" EKLENDİ -->
                <Button Grid.Column="2" Content="&gt;" Style="{StaticResource StatusArrowButton}" Margin="0,0,4,0"
            Width="18" Height="30" Command="{Binding Status.NextCommand}"
            ToolTip="Sonraki gösterge" AutomationProperties.Name="Sonraki gösterge" />
            </Grid>
        </Border>

        <!-- Tabs (with "+" right after them) on the first row, navigation on the second. -->
        <Grid Grid.Column="1" Margin="14,0,29,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="37.5" />
                <RowDefinition Height="6.5" />
                <RowDefinition Height="29" />
            </Grid.RowDefinitions>
            <views:TabStripView Grid.Row="0" />
            <views:NavigationBarView x:Name="NavigationBar" Grid.Row="2" Margin="-5,0,0,0" Loaded="NavigationBar_Loaded" />
        </Grid>

        <!-- Window controls, a divider line, then menu and profile. -->
        <Grid Grid.Column="2" Width="84" Margin="0,0,14,0" VerticalAlignment="Center" Height="78">
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="3" />
                <RowDefinition Height="29" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,9,0,0">
                <Button Style="{StaticResource WindowDotButton}" Background="{StaticResource DotGreenBrush}"
                        Margin="0,0,17,0" Click="OnMaximizeClick"
                        ToolTip="Büyüt / Eski boyut" AutomationProperties.Name="Büyüt veya eski boyuta getir" />
                <Button Style="{StaticResource WindowDotButton}" Background="{StaticResource DotYellowBrush}"
                        Margin="0,0,17,0" Click="OnMinimizeClick"
                        ToolTip="Simge durumuna küçült" AutomationProperties.Name="Simge durumuna küçült" />
                <Button Style="{StaticResource WindowDotButton}" Background="{StaticResource DotRedBrush}"
                        Click="OnCloseClick" ToolTip="Kapat" AutomationProperties.Name="Kapat" />
            </StackPanel>

            <Border Background="{DynamicResource BoxShadowBrush}" Margin="0,32,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0" Grid.RowSpan="3">
                <!-- Menu icon from the design: two dark bars and a gray one. -->
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Margin="0,10,10,0"
                        Command="{Binding Settings.OpenCommand}"
                        ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar">
                    <StackPanel>
                        <Rectangle Width="17" Height="1.5" Fill="{DynamicResource TextBrush}" />
                        <Rectangle Width="17" Height="1.5" Fill="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                        <Rectangle Width="17" Height="2.5" Fill="{DynamicResource BoxShadowBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}"
                        ToolTip="Profil (yakında)" AutomationProperties.Name="Profil" Margin="0,10,0,0">
                    <Grid>
                        <Ellipse Width="22" Height="22" Fill="{DynamicResource BoxBrush}"
                                 Stroke="{DynamicResource BoxShadowBrush}" StrokeThickness="1.5" />
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource IconBrush}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Loading indicator overlays the bottom edge of the bar. -->
        <ProgressBar Grid.ColumnSpan="3" VerticalAlignment="Bottom" IsIndeterminate="True" Height="2.5"
                     BorderThickness="0" Foreground="{DynamicResource AccentBrush}" Background="Transparent"
                     IsHitTestVisible="False"
                     Visibility="{Binding ActiveTab.IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <!-- Redesigned Settings Popup: Main 6-tile grid, Yer İmleri, Arama Geçmişi, and Renk Temaları -->
        <Popup PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
               HorizontalOffset="-432" VerticalOffset="10" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding Settings.IsOpen, Mode=TwoWay}">
            <Border Width="490" Background="{DynamicResource BoxBrush}" CornerRadius="0,0,18,18"
                    BorderBrush="{DynamicResource SettingsShadowBrush}" BorderThickness="0,0,0,5"
                    Padding="20,16,20,20">
                <Grid>
                    <!-- ========================================================================= -->
                    <!-- 1. MAIN AYARLAR VIEW (6 Setting Tiles + Left/Right Page Navigation Arrows) -->
                    <!-- ========================================================================= -->
                    <Grid Visibility="{Binding Settings.IsMainView, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header: Bold "Ayarlar" on left, circular Close (X) button on top-right -->
                        <Grid Grid.Row="0" Margin="14,0,6,12">
                            <TextBlock Text="Ayarlar" FontWeight="Bold" FontSize="28"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />

                            <Button Style="{StaticResource SettingsCircleButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding Settings.CloseCommand}"
                                    ToolTip="Kapat" AutomationProperties.Name="Ayarları kapat">
                                <Path Data="M0,0 L7,7 M7,0 L0,7"
                                      Stroke="{DynamicResource SettingsCircleButtonGlyphBrush}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="7" Height="7" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!-- Body: Left (<) arrow + 3x2 Setting Cards Grid + Right (>) arrow -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Page Button (<) -->
                            <Button Grid.Column="0" Style="{StaticResource SettingsCircleButton}"
                                    Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,4,0"
                                    Command="{Binding Settings.PreviousPageCommand}"
                                    ToolTip="Önceki sayfa" AutomationProperties.Name="Önceki ayar sayfası">
                                <Path Data="M5,0 L0,4.5 L5,9"
                                      Stroke="{DynamicResource SettingsCircleButtonGlyphBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="6" Height="9" Stretch="Uniform" Margin="-1,0,0,0" />
                            </Button>

                            <!-- 6 Setting Tiles (3 columns x 2 rows) -->
                            <UniformGrid Grid.Column="1" Columns="3" Rows="2" HorizontalAlignment="Center">
                                <!-- Tile 1: Güvenli Mod (eye-hidden-svgrepo-com.svg) -->
                                <Button Style="{StaticResource SettingsTileButton}"
                                        Command="{Binding Settings.ToggleSafeModeCommand}"
                                        ToolTip="Güvenli Mod (Geçmiş kaydını duraklatır)" AutomationProperties.Name="Güvenli Mod">
                                    <Grid>
                                        <Ellipse Width="8" Height="8" Fill="#628464"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                                                 Visibility="{Binding Settings.IsSafeModeEnabled, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Grid Width="42" Height="42" Margin="0,0,0,8">
                                                <Ellipse Fill="{DynamicResource SettingsIconCircleBrush}" />
                                                <Path Data="{StaticResource EyeHiddenIconGeometry}"
                                                      Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="21" Height="21" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="Güvenli&#x0a;Mod" FontWeight="Bold" FontSize="14.5"
                                                       Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                                                       LineStackingStrategy="BlockLineHeight" LineHeight="17" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Tile 2: Yer İmleri (bookmark-svgrepo-com.svg) -->
                                <Button Style="{StaticResource SettingsTileButton}"
                                        Command="{Binding Settings.OpenBookmarksCommand}"
                                        ToolTip="Yer İmleri" AutomationProperties.Name="Yer İmleri">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid Width="42" Height="42" Margin="0,0,0,8">
                                            <Ellipse Fill="{DynamicResource SettingsIconCircleBrush}" />
                                            <Path Data="{StaticResource BookmarkIconGeometry}"
                                                  Fill="{DynamicResource TextBrush}"
                                                  Width="15" Height="18" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="Yer&#x0a;İmleri" FontWeight="Bold" FontSize="14.5"
                                                   Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                                                   LineStackingStrategy="BlockLineHeight" LineHeight="17" />
                                    </StackPanel>
                                </Button>

                                <!-- Tile 3: Arama Geçmişi (history-line-icon.svg) -->
                                <Button Style="{StaticResource SettingsTileButton}"
                                        Command="{Binding Settings.OpenHistoryCommand}"
                                        ToolTip="Arama Geçmişi" AutomationProperties.Name="Arama Geçmişi">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid Width="42" Height="42" Margin="0,0,0,8">
                                            <Ellipse Fill="{DynamicResource SettingsIconCircleBrush}" />
                                            <Path Data="{StaticResource HistoryLineIconGeometry}"
                                                  Fill="{DynamicResource TextBrush}"
                                                  Width="20" Height="20" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="Arama&#x0a;Geçmişi" FontWeight="Bold" FontSize="14.5"
                                                   Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                                                   LineStackingStrategy="BlockLineHeight" LineHeight="17" />
                                    </StackPanel>
                                </Button>

                                <!-- Tile 4: Renk Temaları (paint-palette-icon.svg) -->
                                <Button Style="{StaticResource SettingsTileButton}"
                                        Command="{Binding Settings.OpenThemesCommand}"
                                        ToolTip="Renk Temaları" AutomationProperties.Name="Renk Temaları">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid Width="42" Height="42" Margin="0,0,0,8">
                                            <Ellipse Fill="{DynamicResource SettingsIconCircleBrush}" />
                                            <Path Data="{StaticResource PaintPaletteIconGeometry}"
                                                  Fill="{DynamicResource TextBrush}"
                                                  Width="21" Height="20" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="Renk&#x0a;Temaları" FontWeight="Bold" FontSize="14.5"
                                                   Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                                                   LineStackingStrategy="BlockLineHeight" LineHeight="17" />
                                    </StackPanel>
                                </Button>

                                <!-- Tile 5: İndirmeler (standard downloadicon.png) -->
                                <Button Style="{StaticResource SettingsTileButton}"
                                        Command="{Binding Settings.OpenDownloadsCommand}"
                                        ToolTip="İndirmeler" AutomationProperties.Name="İndirmeler">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid Width="42" Height="42" Margin="0,0,0,12">
                                            <Ellipse Fill="{DynamicResource SettingsIconCircleBrush}" />
                                            <Rectangle Width="19" Height="19" Fill="{DynamicResource TextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="pack://application:,,,/Resources/Icons/downloadicon.png" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>
                                        <TextBlock Text="İndirmeler" FontWeight="Bold" FontSize="14.5"
                                                   Foreground="{DynamicResource TextBrush}" TextAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Tile 6: Performans Modu (speedometer-icon.svg) -->
                                <Button Style="{StaticResource SettingsTileButton}"
                                        Command="{Binding Settings.TogglePerformanceModeCommand}"
                                        ToolTip="Performans Modu (Bellek kullanımını optimize eder)" AutomationProperties.Name="Performans Modu">
                                    <Grid>
                                        <Ellipse Width="8" Height="8" Fill="#628464"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                                                 Visibility="{Binding Settings.IsPerformanceModeEnabled, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Grid Width="42" Height="42" Margin="0,0,0,8">
                                                <Ellipse Fill="{DynamicResource SettingsIconCircleBrush}" />
                                                <Path Data="{StaticResource SpeedometerIconGeometry}"
                                                      Fill="{DynamicResource TextBrush}"
                                                      Width="21" Height="19" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="Performans&#x0a;Modu" FontWeight="Bold" FontSize="14.5"
                                                       Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                                                       LineStackingStrategy="BlockLineHeight" LineHeight="17" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </UniformGrid>

                            <!-- Right Page Button (>) -->
                            <Button Grid.Column="2" Style="{StaticResource SettingsCircleButton}"
                                    Width="24" Height="24" VerticalAlignment="Center" Margin="4,0,0,0"
                                    Command="{Binding Settings.NextPageCommand}"
                                    ToolTip="Sonraki sayfa" AutomationProperties.Name="Sonraki ayar sayfası">
                                <Path Data="M0,0 L5,4.5 L0,9"
                                      Stroke="{DynamicResource SettingsCircleButtonGlyphBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="6" Height="9" Stretch="Uniform" Margin="1,0,0,0" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- ========================================================================= -->
                    <!-- 2. YER İMLERİ SUB-VIEW (Matches Image 2 mockup)                           -->
                    <!-- ========================================================================= -->
                    <Grid Visibility="{Binding Settings.IsBookmarksView, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: Bookmark circle badge + "Yer İmleri" title on left, Back + Close on right -->
                        <Grid Grid.Row="0" Margin="4,0,4,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="36" Height="36" Margin="0,0,12,0">
                                    <Ellipse Fill="{DynamicResource SettingsIconCircleBrush}" />
                                    <Path Data="{StaticResource BookmarkIconGeometry}"
                                          Fill="{DynamicResource TextBrush}"
                                          Width="13" Height="16" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Yer İmleri" FontWeight="Bold" FontSize="28"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Back Button (↩) -->
                                <Button Style="{StaticResource SettingsCircleButton}" Margin="0,0,8,0"
                                        Command="{Binding Settings.BackToMainCommand}"
                                        ToolTip="Ayarlara Dön" AutomationProperties.Name="Ayarlara dön">
                                    <Path Data="M4,1 L0.5,4 L4,7 M1,4 H8.5 C10.5,4 12,5.3 12,7 C12,8.7 10.5,10 8.5,10 H4"
                                          Stroke="{DynamicResource SettingsCircleButtonGlyphBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="11" Height="9" Stretch="Uniform" />
                                </Button>

                                <!-- Close Button (X) -->
                                <Button Style="{StaticResource SettingsCircleButton}"
                                        Command="{Binding Settings.CloseCommand}"
                                        ToolTip="Kapat" AutomationProperties.Name="Kapat">
                                    <Path Data="M0,0 L7,7 M7,0 L0,7"
                                          Stroke="{DynamicResource SettingsCircleButtonGlyphBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="7" Height="7" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Quick "+ Bu Sayfayı Yer İmlerine Ekle / Çıkar" bar when active tab is on a web page -->
                        <Button Grid.Row="1" Style="{StaticResource SavedPagePillButton}"
                                Command="{Binding ToggleBookmarkCommand}"
                                Visibility="{Binding ActiveTab.IsWebViewVisible, Converter={StaticResource BoolToVisibility}}"
                                Margin="4,0,22,12" Height="34">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource BookmarkIconGeometry}"
                                      Fill="{DynamicResource IconBrush}" Width="12" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="17"
                                        BorderBrush="{DynamicResource BoxShadowBrush}" BorderThickness="4,0,0,0">
                                    <TextBlock Text="Aktif sayfayı yer imlerine ekle / çıkar"
                                               FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               VerticalAlignment="Center" Margin="14,0,12,0" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Bookmarks List with Custom Capsule ScrollBar -->
                        <ScrollViewer Grid.Row="2" MaxHeight="360" Margin="4,0,0,0"
                                      VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SettingsScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <Grid Margin="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding Settings.BookmarkItems}"
                                              ItemTemplate="{StaticResource BookmarkItemTemplate}"
                                              Focusable="False" IsTabStop="False" />

                                <TextBlock Text="Henüz kaydedilmiş bir yer imi bulunmuyor."
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.HasBookmarkItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========================================================================= -->
                    <!-- 3. ARAMA GEÇMİŞİ SUB-VIEW (Search bar + Clear button + Day-grouped pills) -->
                    <!-- ========================================================================= -->
                    <Grid Visibility="{Binding Settings.IsHistoryView, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: History circle badge + "Arama Geçmişi" title on left, Back + Close on right -->
                        <Grid Grid.Row="0" Margin="4,0,4,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="36" Height="36" Margin="0,0,12,0">
                                    <Ellipse Fill="{DynamicResource SettingsIconCircleBrush}" />
                                    <Path Data="{StaticResource HistoryLineIconGeometry}"
                                          Fill="{DynamicResource TextBrush}"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Arama Geçmişi" FontWeight="Bold" FontSize="28"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Back Button (↩) -->
                                <Button Style="{StaticResource SettingsCircleButton}" Margin="0,0,8,0"
                                        Command="{Binding Settings.BackToMainCommand}"
                                        ToolTip="Ayarlara Dön" AutomationProperties.Name="Ayarlara dön">
                                    <Path Data="M4,1 L0.5,4 L4,7 M1,4 H8.5 C10.5,4 12,5.3 12,7 C12,8.7 10.5,10 8.5,10 H4"
                                          Stroke="{DynamicResource SettingsCircleButtonGlyphBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="11" Height="9" Stretch="Uniform" />
                                </Button>

                                <!-- Close Button (X) -->
                                <Button Style="{StaticResource SettingsCircleButton}"
                                        Command="{Binding Settings.CloseCommand}"
                                        ToolTip="Kapat" AutomationProperties.Name="Kapat">
                                    <Path Data="M0,0 L7,7 M7,0 L0,7"
                                          Stroke="{DynamicResource SettingsCircleButtonGlyphBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="7" Height="7" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Search Bar ("Arama Yapın" + Magnifying glass) + Coral-Red Clear Button -->
                        <Grid Grid.Row="1" Margin="4,0,22,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Bar Pill -->
                            <Border Grid.Column="0" Height="32" CornerRadius="16"
                                    Background="{DynamicResource HistorySearchBarBrush}"
                                    BorderBrush="{DynamicResource SettingsShadowBrush}"
                                    BorderThickness="1,1,1,2.5" Padding="14,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Arama Yapın"
                                               Foreground="{DynamicResource HistorySearchTextBrush}"
                                               FontSize="12.5" VerticalAlignment="Center"
                                               IsHitTestVisible="False" Opacity="0.92"
                                               Visibility="{Binding Settings.IsHistorySearchEmpty, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource PlainTextBox}"
                                             Text="{Binding Settings.HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Foreground="{DynamicResource HistorySearchTextBrush}"
                                             CaretBrush="{DynamicResource HistorySearchTextBrush}"
                                             FontSize="12.5" FontWeight="SemiBold"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="Geçmişte Ara" />

                                    <!-- Magnifying glass icon -->
                                    <Path Grid.Column="1"
                                          Data="M 6.5,1 A 5.5,5.5 0 1 1 6.49,1 M 10.5,10.5 L 15,15"
                                          Stroke="{DynamicResource HistorySearchTextBrush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="15" Height="15" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="8,0,0,0"
                                          IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <!-- Red "Geçmişi Temizle" / "Seçilen Verileri Temizle" Button -->
                            <Button Grid.Column="1" Style="{StaticResource HistoryDangerButtonStyle}"
                                    Margin="12,0,0,0"
                                    Command="{Binding Settings.HistoryClearActionCommand}"
                                    ToolTip="{Binding Settings.ClearHistoryButtonText}"
                                    AutomationProperties.Name="{Binding Settings.ClearHistoryButtonText}">
                                <TextBlock Text="{Binding Settings.ClearHistoryButtonText}"
                                           FontWeight="Bold" FontSize="11"
                                           Foreground="White" />
                            </Button>
                        </Grid>

                        <!-- Row 2: History List with Custom Capsule ScrollBar -->
                        <ScrollViewer Grid.Row="2" MaxHeight="360" Margin="4,0,0,0"
                                      VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SettingsScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <Grid Margin="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding Settings.HistoryItems}"
                                              ItemTemplate="{StaticResource HistoryItemTemplate}"
                                              Focusable="False" IsTabStop="False" />

                                <TextBlock Text="Arama geçmişinde kayıt bulunamadı."
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.HasHistoryItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========================================================================= -->
                    <!-- 3B. GEÇMİŞİ TEMİZLE SUB-VIEW (5 Time-Range Options)                       -->
                    <!-- ========================================================================= -->
                    <Grid Visibility="{Binding Settings.IsClearHistoryView, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: History circle badge + "Geçmişi Temizle" title on left, Back + Close on right -->
                        <Grid Grid.Row="0" Margin="4,0,4,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="36" Height="36" Margin="0,0,12,0">
                                    <Ellipse Fill="{DynamicResource SettingsIconCircleBrush}" />
                                    <Path Data="{StaticResource HistoryLineIconGeometry}"
                                          Fill="{DynamicResource TextBrush}"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Geçmişi Temizle" FontWeight="Bold" FontSize="26"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Back Button (↩ returns to Arama Geçmişi) -->
                                <Button Style="{StaticResource SettingsCircleButton}" Margin="0,0,8,0"
                                        Command="{Binding Settings.BackToMainCommand}"
                                        ToolTip="Arama Geçmişine Dön" AutomationProperties.Name="Arama geçmişine dön">
                                    <Path Data="M4,1 L0.5,4 L4,7 M1,4 H8.5 C10.5,4 12,5.3 12,7 C12,8.7 10.5,10 8.5,10 H4"
                                          Stroke="{DynamicResource SettingsCircleButtonGlyphBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="11" Height="9" Stretch="Uniform" />
                                </Button>

                                <!-- Close Button (X) -->
                                <Button Style="{StaticResource SettingsCircleButton}"
                                        Command="{Binding Settings.CloseCommand}"
                                        ToolTip="Kapat" AutomationProperties.Name="Kapat">
                                    <Path Data="M0,0 L7,7 M7,0 L0,7"
                                          Stroke="{DynamicResource SettingsCircleButtonGlyphBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="7" Height="7" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="Silinecek geçmiş zaman aralığını seçin:"
                                   FontWeight="Bold" FontSize="13.5"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="6,0,0,12" />

                        <!-- 5 Time-range options: Son yarım saat, Son bir saat, Son bir gün, Son bir hafta, Hepsi -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Settings.ClearHistoryOptions}"
                                      Margin="4,0,4,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SavedPagePillButton}"
                                            Command="{Binding DataContext.Settings.ClearHistoryByRangeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Label}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left #F0F0F0 compartment with history clock icon -->
                                            <Path Grid.Column="0" Data="{StaticResource HistoryLineIconGeometry}"
                                                  Fill="{DynamicResource IconBrush}"
                                                  Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- Middle crescent compartment with option label -->
                                            <Border Grid.Column="1" CornerRadius="19,0,0,19"
                                                    Background="{DynamicResource SettingsCardBrush}"
                                                    BorderBrush="{DynamicResource BoxShadowBrush}"
                                                    BorderThickness="4,0,0,0">
                                                <TextBlock Text="{Binding Label}"
                                                           FontWeight="Bold" FontSize="14"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           VerticalAlignment="Center" Margin="14,0,10,0" />
                                            </Border>

                                            <!-- Right #F0F0F0 compartment with coral-red "Temizle" badge -->
                                            <Border Grid.Column="2" Background="{DynamicResource DangerButtonBrush}"
                                                    CornerRadius="11" Padding="10,4" Margin="10,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="Temizle" FontWeight="Bold" FontSize="10.5" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- ========================================================================= -->
                    <!-- 4. RENK TEMALARI SUB-VIEW                                                 -->
                    <!-- ========================================================================= -->
                    <Grid Visibility="{Binding Settings.IsThemesView, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: Palette circle badge + "Renk Temaları" title on left, Back + Close on right -->
                        <Grid Grid.Row="0" Margin="4,0,4,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="36" Height="36" Margin="0,0,12,0">
                                    <Ellipse Fill="{DynamicResource SettingsIconCircleBrush}" />
                                    <Path Data="{StaticResource PaintPaletteIconGeometry}"
                                          Fill="{DynamicResource TextBrush}"
                                          Width="18" Height="17" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Renk Temaları" FontWeight="Bold" FontSize="28"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Back Button (↩) -->
                                <Button Style="{StaticResource SettingsCircleButton}" Margin="0,0,8,0"
                                        Command="{Binding Settings.BackToMainCommand}"
                                        ToolTip="Ayarlara Dön" AutomationProperties.Name="Ayarlara dön">
                                    <Path Data="M4,1 L0.5,4 L4,7 M1,4 H8.5 C10.5,4 12,5.3 12,7 C12,8.7 10.5,10 8.5,10 H4"
                                          Stroke="{DynamicResource SettingsCircleButtonGlyphBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="11" Height="9" Stretch="Uniform" />
                                </Button>

                                <!-- Close Button (X) -->
                                <Button Style="{StaticResource SettingsCircleButton}"
                                        Command="{Binding Settings.CloseCommand}"
                                        ToolTip="Kapat" AutomationProperties.Name="Kapat">
                                    <Path Data="M0,0 L7,7 M7,0 L0,7"
                                          Stroke="{DynamicResource SettingsCircleButtonGlyphBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="7" Height="7" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" MaxHeight="380" Margin="4,0,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SettingsScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Tema Seçimi" FontWeight="Bold" FontSize="13.5"
                                           Foreground="{DynamicResource TextBrush}" Margin="4,0,0,8" />

                                <!-- Color Themes presented in the same crescent pill style -->
                                <ItemsControl ItemsSource="{Binding Settings.Themes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SavedPagePillButton}"
                                                    Command="{Binding DataContext.Settings.SelectThemeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Theme color swatch on left -->
                                                    <Ellipse Grid.Column="0" Width="20" Height="20" Fill="{Binding Swatch}"
                                                             Stroke="{DynamicResource SettingsShadowBrush}" StrokeThickness="1.5"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <!-- Theme name after crescent -->
                                                    <Border Grid.Column="1" CornerRadius="19"
                                                            BorderBrush="{DynamicResource BoxShadowBrush}"
                                                            BorderThickness="4,0,0,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   VerticalAlignment="Center" Margin="14,0,14,0" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Ana Sayfa Arka Planı" FontWeight="Bold" FontSize="13.5"
                                           Foreground="{DynamicResource TextBrush}" Margin="4,8,0,8" />

                                <ListBox ItemsSource="{Binding Settings.Backgrounds}"
                                         SelectedItem="{Binding Settings.SelectedBackground}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="Arka plan">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" ClipToBounds="True" Margin="2"
                                                    BorderBrush="{DynamicResource SettingsShadowBrush}" BorderThickness="0,0,0,3">
                                                <Image Source="{Binding ThumbnailUri}" Width="128" Height="64" Stretch="UniformToFill"
                                                       ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Background="{DynamicResource SettingsCardBrush}" CornerRadius="16"
                                        BorderBrush="{DynamicResource SettingsShadowBrush}" BorderThickness="0,0,0,3"
                                        Padding="14,10" Margin="0,12,0,4">
                                    <CheckBox IsChecked="{Binding Settings.OnlineSuggestionsEnabled}"
                                              Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                              AutomationProperties.Name="Çevrimiçi arama önerileri"
                                              ToolTip="Yazdıklarınız öneri almak için Google'a gönderilir. Adres olarak algılanan metinler gönderilmez.">
                                        <TextBlock Text="Çevrimiçi arama önerileri (Google)" TextWrapping="Wrap" />
                                    </CheckBox>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
