<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colorful theme: violet boxes with a pink accent. -->
    <SolidColorBrush x:Key="BarBrush" Color="#F1EDFF" />
    <SolidColorBrush x:Key="BoxBrush" Color="#C9B8FF" />
    <SolidColorBrush x:Key="BoxShadowBrush" Color="#8E73E8" />
    <SolidColorBrush x:Key="BoxHoverBrush" Color="#B9A5F8" />
    <SolidColorBrush x:Key="FieldBrush" Color="#E3DAFF" />
    <SolidColorBrush x:Key="FieldFocusBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#2B1B5C" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#7B6BB0" />
    <SolidColorBrush x:Key="IconBrush" Color="#4B34A8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF5C93" />
    <SolidColorBrush x:Key="ActiveTabEdgeBrush" Color="#FF5C93" />
    <SolidColorBrush x:Key="PopupBrush" Color="#F7F4FF" />
    <SolidColorBrush x:Key="HomeTitleBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#66463A80" />
    <SolidColorBrush x:Key="TileBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="TileHoverBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="TileBorderBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="TileTextBrush" Color="#2B1B5C" />
</ResourceDictionary>
