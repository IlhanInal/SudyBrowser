<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Default theme: #D9D9D9 boxes with a #A6A6A6 edge, as in the design mock-up. -->
    <SolidColorBrush x:Key="BarBrush" Color="#F6F6F6" />
    <SolidColorBrush x:Key="BoxBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="BoxShadowBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="BoxHoverBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="FieldBrush" Color="#E8E7E7" />
    <SolidColorBrush x:Key="FieldFocusBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B1E1D" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="IconBrush" Color="#545454" />
    <SolidColorBrush x:Key="AccentBrush" Color="#202020" />
    <SolidColorBrush x:Key="ActiveTabEdgeBrush" Color="#545454" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="HomeTitleBrush" Color="#1B1E1D" />
    <!-- Dark translucent layer over the home background (#545454, ~50% opacity). -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#80545454" />
    <SolidColorBrush x:Key="TileBrush" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="TileHoverBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="TileBorderBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="TileTextBrush" Color="#1B1E1D" />
    <SolidColorBrush x:Key="SettingsCardBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="SettingsCardHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SettingsShadowBrush" Color="#545454" />
    <SolidColorBrush x:Key="SettingsIconCircleBrush" Color="#E3E3E3" />
    <SolidColorBrush x:Key="SettingsCircleButtonBrush" Color="#545454" />
    <SolidColorBrush x:Key="SettingsCircleButtonGlyphBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="HistoryPillSideBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="HistorySearchBarBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="HistorySearchTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerButtonBrush" Color="#FF7D7D" />
    <SolidColorBrush x:Key="DangerButtonHoverBrush" Color="#FF6B6B" />
    <BitmapImage x:Key="HomeLogoSource" UriSource="pack://application:,,,/Resources/Icons/sudybrowserlogo_white.png" />
</ResourceDictionary>
